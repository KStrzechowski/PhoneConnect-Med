      "transferToMainMenu": { "position": { "x": 640, "y": 200 } },
      "transferQueue": { "position": { "x": 640, "y": 40 } },
      "disconnectEnd": { "position": { "x": 840, "y": 40 } }
    },
    "Annotations": []
  },
  "Actions": [
    {
      "Identifier": "voice",
      "Type": "UpdateContactTextToSpeechVoice",
      "Parameters": { "TextToSpeechEngine": "Neural", "TextToSpeechVoice": "Ola" },
      "Transitions": {
        "NextAction": "setMsgMenu",
        "Errors": [{ "NextAction": "setMsgMenu", "ErrorType": "NoMatchingError" }]
      }
    },
    {
      "Identifier": "setMsgMenu",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "lastMessageText": "Tożsamość została potwierdzona. Naciśnij 1, aby umówić wizytę. Naciśnij 2, aby usłyszeć swoje wizyty. Naciśnij 3, aby odwołać wizytę. Naciśnij 4, aby przełożyć wizytę. Naciśnij 0, aby połączyć się z konsultantem. Naciśnij gwiazdkę, aby powtórzyć."
        },
        "TargetContact": "Current"
      },
      "Transitions": {
        "NextAction": "menuPrompt",
        "Errors": [{ "NextAction": "menuPrompt", "ErrorType": "NoMatchingError" }]
      }
    },
    {
      "Identifier": "menuPrompt",
      "Type": "GetParticipantInput",
      "Parameters": {
        "Text": "$.Attributes.lastMessageText",
        "InputTimeLimitSeconds": "10"
      },
      "Transitions": {
        "NextAction": "menuPrompt",
        "Conditions": [
          { "NextAction": "transferToBookingFlow", "Condition": { "Operator": "Equals", "Operands": ["1"] } },
          { "NextAction": "transferToAppointmentListFlow", "Condition": { "Operator": "Equals", "Operands": ["2"] } },
          { "NextAction": "transferToAppointmentCancelFlow", "Condition": { "Operator": "Equals", "Operands": ["3"] } },
          { "NextAction": "transferToAppointmentRescheduleFlow", "Condition": { "Operator": "Equals", "Operands": ["4"] } },
          { "NextAction": "transferQueue", "Condition": { "Operator": "Equals", "Operands": ["0"] } },
          { "NextAction": "repeatMenu", "Condition": { "Operator": "Equals", "Operands": ["*"] } },
          { "NextAction": "transferToMainMenu", "Condition": { "Operator": "Equals", "Operands": ["#"] } }
        ],
        "Errors": [
          { "NextAction": "menuPrompt", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "menuPrompt", "ErrorType": "InputTimeLimitExceeded" },
          { "NextAction": "menuPrompt", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "repeatMenu",
      "Type": "MessageParticipant",
      "Parameters": { "SkipWhenDTMFBufferEnabled": "false", "Text": "$.Attributes.lastMessageText" },
      "Transitions": {
        "NextAction": "menuPrompt",
        "Errors": [{ "NextAction": "menuPrompt", "ErrorType": "NoMatchingError" }]
      }
    },
    {
      "Identifier": "transferToBookingFlow",
