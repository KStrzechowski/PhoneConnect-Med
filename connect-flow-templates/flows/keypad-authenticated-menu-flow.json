      "transferToBookingFlow": { "position": { "x": 640, "y": -140 } },
      "transferToAppointmentListFlow": { "position": { "x": 640, "y": -260 } },
      "transferToAppointmentCancelFlow": { "position": { "x": 640, "y": -380 } },
